# Docker Compose の値補間に利用する Local 設定例。
# 実際の学習時は .env へ Copy し、.env 自体は Git へ Commit しない。

FRONTEND_PORT=5173
BACKEND_PORT=8080

# Production Build 後の React JavaScript に埋め込まれる公開 API URL。
# Browser から利用する値なので Secret を設定しない。
VITE_API_BASE_URL=http://localhost:8080

CORS_ALLOWED_ORIGIN=http://localhost:5173

POSTGRES_DB=unit12_db
POSTGRES_USER=unit12_user
POSTGRES_PASSWORD=unit12-password
