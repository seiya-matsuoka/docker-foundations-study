# Docker Compose の値補間に利用する Local 設定例。
# 実際の学習時は .env へ Copy し、.env 自体は Git へ Commit しない。

# Host Browser から各 Service へアクセスする Port。
FRONTEND_PORT=5173
BACKEND_PORT=8080

# React の JavaScript は Browser 上で実行されるため、
# Docker Network 内の Service 名 backend ではなく Host Browser から到達できる URL を指定する。
VITE_API_BASE_URL=http://localhost:8080

# Spring Boot が Browser からの Cross-Origin Request を許可する Origin。
CORS_ALLOWED_ORIGIN=http://localhost:5173

# PostgreSQL の Local 学習用設定。
POSTGRES_DB=unit11_db
POSTGRES_USER=unit11_user
POSTGRES_PASSWORD=unit11-password
